rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /deals/{id} {
      allow read: if request.auth != null && request.auth.token.email_verified == true && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == request.auth.token.email.lower());
      allow create: if request.auth != null && request.auth.token.email_verified == true && request.resource.data.keys().hasOnly(['fromUid','fromEmail','fromName','toEmail','toName','fruit','kg','boxKg','price','due','date','status','root','createdAt']) && request.resource.data.fromUid == request.auth.uid && request.resource.data.fromEmail == request.auth.token.email.lower() && request.resource.data.status == 'pending' && request.resource.data.toEmail is string && request.resource.data.toEmail.size() < 200 && request.resource.data.toEmail == request.resource.data.toEmail.lower() && request.resource.data.toEmail != request.resource.data.fromEmail && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100 && request.resource.data.toName is string && request.resource.data.toName.size() <= 100 && request.resource.data.fruit is string && request.resource.data.fruit.size() <= 100 && (request.resource.data.kg is int || request.resource.data.kg is float) && request.resource.data.kg > 0 && (request.resource.data.price is int || request.resource.data.price is float) && request.resource.data.price >= 0 && request.resource.data.createdAt == request.time && (request.resource.data.get('root', null) == null || (request.resource.data.root is string && get(/databases/$(database)/documents/deals/$(request.resource.data.root)).data.fromUid == request.auth.uid));
      allow update: if request.auth != null && request.auth.token.email_verified == true && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']) && request.resource.data.respondedAt == request.time && ((resource.data.toEmail == request.auth.token.email.lower() && request.resource.data.status in ['accepted','declined']) || (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }
  }
}
